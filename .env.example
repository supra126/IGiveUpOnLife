# ===========================================
# 網站設定
# ===========================================
# 網站 URL（用於 SEO、Open Graph、sitemap 等）
# 預設：https://igiveup.simoko.com
NEXT_PUBLIC_SITE_URL=

# ===========================================
# Gemini API 設定
# ===========================================
# Gemini API 金鑰（選填 - 若設定，用戶可免費使用，無需自備金鑰）
# 取得金鑰：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini 文字模型（選填 - 預設：gemini-3.8-flash）
# - gemini-3.8-flash：穩定版，速度快（推薦）
# - gemini-3.1-pro-preview：推理較強，預覽版
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Gemini 圖片模型（選填 - 預設：gemini-nano-banana-2.1）
# - gemini-nano-banana-2.1：Nano Banana 2.1，品質與速度均衡（推薦）
# - gemini-3-pro-image：Nano Banana Pro，複雜場景品質最佳，較慢較貴
# - gemini-3.1-flash-lite-image：Nano Banana 2 Lite，最快最便宜，僅支援 1K
# 註：gemini-3-pro-image-preview、gemini-3.1-flash-image-preview 已於 2026-06-25 下架
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ===========================================
# 靜態建構模式客戶端設定（BUILD_MODE=static 時使用）
# 建構時內聯到客戶端程式碼，不需要伺服器
# ===========================================
NEXT_PUBLIC_GEMINI_TEXT_MODEL=gemini-3.8-flash
NEXT_PUBLIC_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# 伺服器金鑰可使用的模型白名單（選填，逗號分隔；未設定則不限制）
# 公開 demo 建議只開放較便宜的模型，避免伺服器金鑰被拿去大量使用 Pro
# 使用者在介面輸入自己的金鑰時不受此限制
# GEMINI_ALLOWED_IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3.1-flash-lite-image
# GEMINI_ALLOWED_TEXT_MODELS=gemini-3.8-flash

# ===========================================
# 伺服器版速率限制（僅在使用伺服器 API 金鑰時生效）
# ===========================================
# 時間窗口（毫秒）（預設：60000 = 1 分鐘）
RATE_LIMIT_WINDOW_MS=60000
# 每個時間窗口的最大請求數（預設：2）
# 注意：Gemini 圖片模型免費版限制為 2 RPM
RATE_LIMIT_MAX_REQUESTS=2
# 啟用/停用速率限制（預設：true）
RATE_LIMIT_ENABLED=true
# 如何辨識用戶端 IP（預設：不信任任何 header，所有人共用同一份額度）
# - cloudflare：只信任 cf-connecting-ip（origin 必須只接受 Cloudflare 流量）
# - 數字 N：信任 X-Forwarded-For 從右數第 N 個（前面有 N 層可信代理，例如 Railway 設 1）
# 注意：使用者在介面輸入自己的金鑰時不會被限流
TRUST_PROXY=

# ===========================================
# Cloudflare Zero Trust Access（選填）
# 經過 Zero Trust 驗證的用戶將不受速率限制
# ===========================================
# 你的 Cloudflare Zero Trust 團隊名稱
# 可在 Cloudflare Zero Trust Dashboard > Settings > Custom Pages 找到
# 例如：your-team-name（對應 your-team-name.cloudflareaccess.com）
CF_ACCESS_TEAM_NAME=
# 應用程式的 Audience (AUD) 標籤
# 可在 Access > Applications > 你的應用程式 > Overview > Application Audience (AUD) Tag 找到
CF_ACCESS_AUD=

# ===========================================
# Next.js 設定
# ===========================================
# Server Actions 請求大小限制（預設：20mb）
# 控制上傳圖片的最大檔案大小
SERVER_ACTIONS_BODY_SIZE_LIMIT=20mb
